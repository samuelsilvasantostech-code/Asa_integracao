{
  "manifestVersion": 1,
  "id": "kentro.asa-saude",
  "name": "ClinFy",
  "version": "0.24.0",
  "description": "ClinFy: pacientes, consultas e agenda do sistema (ERP) da clínica, no atendimento e em tela cheia.",
  "author": {
    "name": "Kentro"
  },
  "icon": "icon.svg",
  "config": [
    {
      "key": "queueIds",
      "label": "Filas atendidas (ids separados por vírgula)",
      "type": "string",
      "required": true,
      "help": "Nas demais filas o painel fica inativo."
    },
    {
      "key": "apiUrl",
      "label": "Endereço do Conector",
      "type": "url",
      "default": "https://asa-integracao-samuels.kentro.com.br"
    },
    {
      "key": "apiKey",
      "label": "Chave da instalação",
      "type": "secret",
      "required": false,
      "help": "Gerada pela implantação no Conector, uma por clínica. Sem ela o painel fica \"Sem chave\"."
    }
  ],
  "contributions": [
    {
      "id": "painel",
      "type": "chatPanel",
      "title": "ClinFy",
      "icon": "icon.svg",
      "url": "chat.html"
    },
    {
      "id": "clinfy",
      "type": "topMenu",
      "title": "ClinFy",
      "icon": "icon-clinfy.svg",
      "url": "clinfy.html",
      "presentation": {
        "mode": "fullscreen"
      },
      "visibility": {
        "userTypes": [
          0
        ]
      }
    },
    {
      "id": "agenda",
      "type": "topMenu",
      "title": "Agenda ClinFy",
      "icon": "icon-agenda.svg",
      "url": "agenda.html",
      "presentation": {
        "mode": "fullscreen"
      },
      "visibility": {
        "userTypes": [
          1,
          2
        ]
      }
    }
  ]
}
