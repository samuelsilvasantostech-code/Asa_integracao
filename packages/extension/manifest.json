{
  "manifestVersion": 1,
  "id": "kentro.asa-saude",
  "name": "Asa Saúde",
  "version": "0.16.0",
  "description": "Pacientes, consultas e agenda da clínica na Asa Saúde: no atendimento e em tela cheia.",
  "author": {
    "name": "Kentro"
  },
  "icon": "icon.svg",
  "config": [
    {
      "key": "queueIds",
      "label": "Filas atendidas (ids separados por vírgula)",
      "type": "string",
      "required": true,
      "help": "Nas demais filas o painel fica inativo."
    },
    {
      "key": "apiUrl",
      "label": "Endereço do Conector",
      "type": "url",
      "default": "https://asa-integracao-samuels.kentro.com.br"
    },
    {
      "key": "apiKey",
      "label": "Chave da instalação",
      "type": "secret",
      "required": false,
      "help": "Gerada pela implantação no Conector, uma por clínica. Sem ela o painel fica \"Sem chave\"."
    }
  ],
  "contributions": [
    {
      "id": "painel",
      "type": "chatPanel",
      "title": "Asa Saúde",
      "icon": "icon.svg",
      "url": "chat.html"
    },
    {
      "id": "agenda",
      "type": "topMenu",
      "title": "Agenda Asa",
      "icon": "icon-agenda.svg",
      "url": "agenda.html",
      "presentation": {
        "mode": "fullscreen"
      },
      "visibility": {
        "userTypes": [
          0,
          1,
          2
        ]
      }
    },
    {
      "id": "confirmacao",
      "type": "topMenu",
      "title": "Confirmação Asa",
      "icon": "icon-confirmacao.svg",
      "url": "confirmacao.html",
      "presentation": {
        "mode": "dialog",
        "size": "lg"
      },
      "visibility": {
        "userTypes": [
          0,
          1,
          2
        ]
      }
    },
    {
      "id": "configurar",
      "type": "topMenu",
      "title": "Configurar Asa Saúde",
      "icon": "icon-config.svg",
      "url": "config.html",
      "presentation": {
        "mode": "dialog",
        "size": "md"
      },
      "visibility": {
        "userTypes": [
          0
        ]
      }
    }
  ]
}
